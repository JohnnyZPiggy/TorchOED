{"run_id":"44656949570","source_sha":"e4fad1e38ed6ff6a707abd95ea90ca2dccdffce4","R_version":"R version 4.5.2 (2025-10-31)","support":"0.1.7","design":[[0.49167991479803469,0.33850435037704446],[0.29409546780060936,0.52081010934542893],[0.67695483440933568,0.21964999715610509],[0.060701284762061991,0.60963639026467253],[0.13970949759818785,0.082836740489729693],[0.17116856465481026,0.77014206859885892],[0.28757490511936962,0.30032941424235066],[0.078800326367307771,0.31782064529659015],[0.4054361347297834,0.092996826014360573],[0.74473617003325732,0.046273358431673794]],"example":{"rd_file":"sp.Rd","rd2ex_line":15,"rd2ex":["### Name: sp","### Title: Computing support points using difference-of-convex programming","### Aliases: sp","","### ** Examples","","    ## Not run: ","##D     #############################################################","##D     # Support points on distributions","##D     #############################################################","##D     ","##D     #Generate 25 SPs for the 2-d i.i.d. N(0,1) distribution","##D     n <- 25 #number of points","##D     p <- 2 #dimension","##D     D <- sp(n,p,dist.str=rep(\"normal\",p))","##D     ","##D     x1 <- seq(-3.5,3.5,length.out=100) #Plot contours","##D     x2 <- seq(-3.5,3.5,length.out=100)","##D     z <- exp(-outer(x1^2,x2^2,FUN=\"+\")/2)","##D     contour.default(x=x1,y=x2,z=z,drawlabels=FALSE,nlevels=10)","##D     points(D$sp,pch=16,cex=1.25,col=\"red\")","##D     ","##D     #############################################################","##D     # Generate 50 SPs for the 2-d i.i.d. Beta(2,4) distribution","##D     #############################################################","##D     n <- 50","##D     p <- 2","##D     dist.param <- vector(\"list\",p)","##D     for (l in 1:p){","##D       dist.param[[l]] <- c(2,4)","##D     }","##D     D <- sp(n,p,dist.str=rep(\"beta\",p),dist.param=dist.param)","##D     ","##D     x1 <- seq(0,1,length.out=100) #Plot contours","##D     x2 <- seq(0,1,length.out=100)","##D     z <- matrix(NA,nrow=100,ncol=100)","##D     for (i in 1:100){","##D       for (j in 1:100){","##D         z[i,j] <- dbeta(x1[i],2,4) * dbeta(x2[j],2,4)","##D       }","##D     }","##D     contour.default(x=x1,y=x2,z=z,drawlabels=FALSE,nlevels=10 )","##D     points(D$sp,pch=16,cex=1.25,col=\"red\")","##D     ","##D     #############################################################","##D     # Generate 100 SPs for the 3-d i.i.d. Exp(1) distribution","##D     #############################################################","##D     n <- 100","##D     p <- 3","##D     D <- sp(n,p,dist.str=rep(\"exponential\",p))","##D     pairs(D$sp,xlim=c(0,5),ylim=c(0,5),pch=16)","##D     ","##D     #############################################################","##D     # Support points for big data reduction: Franke's function","##D     #############################################################","##D     ","##D     #Use modified Franke's function as posterior","##D     franke2d <- function(xx){","##D       if ((xx[1]>1)||(xx[1]<0)||(xx[2]>1)||(xx[2]<0)){","##D         return(-Inf)","##D       }","##D       else{","##D         x1 <- xx[1]","##D         x2 <- xx[2]","##D         ","##D         term1 <- 0.75 * exp(-(9*x1-2)^2/4 - (9*x2-2)^2/4)","##D         term2 <- 0.75 * exp(-(9*x1+1)^2/49 - (9*x2+1)/10)","##D         term3 <- 0.5 * exp(-(9*x1-7)^2/4 - (9*x2-3)^2/4)","##D         term4 <- -0.2 * exp(-(9*x1-4)^2 - (9*x2-7)^2)","##D         ","##D         y <- term1 + term2 + term3 + term4","##D         return(2*log(y))","##D       }","##D     }","##D     ","##D   #  library(MHadaptive) # Package archived, but you can use your favorite MCMC sampler","##D     ","##D   #  #Generate MCMC samples","##D   #  li_func <- franke2d #Desired log-posterior","##D   #  ini <- c(0.5,0.5) #Initial point for MCMc","##D   #  NN <- 1e5 #Number of MCMC samples desired","##D   #  burnin <- NN/2 #Number of burn-in runs","##D   #  mcmc_franke <- Metro_Hastings(li_func, pars=ini, prop_sigma=0.05*diag(2),","##D   #                 iterations=NN, burn_in=burnin)","##D     data(mcmc_franke) # Loading MCMC sample from data","##D     ","##D     #Compute n SPs","##D     n <- 100","##D     D <- sp(n,2,dist.samp=mcmc_franke$trace)","##D     ","##D     #Plot SPs","##D     oldpar <- par(mfrow=c(1,2))","##D     x1 <- seq(0,1,length.out=100) #contours","##D     x2 <- seq(0,1,length.out=100)","##D     z <- matrix(NA,nrow=100,ncol=100)","##D     for (i in 1:100){","##D       for (j in 1:100){","##D         z[i,j] <- franke2d(c(x1[i],x2[j]))","##D       }","##D     }","##D     plot(mcmc_franke$trace,pch=4,col=\"gray\",cex=0.75,","##D       xlab=\"\",ylab=\"\",xlim=c(0,1),ylim=c(0,1)) #big data","##D     points(D$sp,pch=16,cex=1.25,col=\"red\")","##D     contour.default(x=x1,y=x2,z=z,drawlabels=TRUE,nlevels=10) #contour","##D     points(D$sp,pch=16,cex=1.25,col=\"red\")","##D     par(oldpar)","##D   ","## End(Not run)","","",""],"call":"##D     D <- sp(n,p,dist.str=rep(\"normal\",p))","design":{},"status":"not comparable: independent standard normal target is not a subset of [0,1]^2"}}
