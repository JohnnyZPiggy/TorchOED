out/*.csv','reports/w3-heldout/H6_fixed.json'],cwd=root,text=True).strip()\nassert not subprocess.check_output(['git','diff',data['source_sha'],'--','src','tests','tools'],cwd=root,text=True).strip()\nlines=['# W4 held-out record: one run, no tuning','',f\"Source `{data['source_sha']}`; Issue #176. Frozen inputs vs `8b74cda`: PASS; src/tests/tools unchanged: PASS; reused reference rows unchanged: PASS.\",json.dumps(data['environment']),data['protocol'],'D = logdet M, efficiency exp((value-best)/p); A/I = trace(M^-1 B), efficiency best/value. Best includes current/W3 TorchOED and unchanged matching W3 references; quality vs W3 is not comparable (1 vs 10 restarts); values are listed as-is. Time PASS means <=3x fastest comparable PyDOE fedorov/modified_fedorov/detmax, excluding sequential. W3 per-restart seconds are its reported median divided by 10; raw and normalized ratios are both shown. Historical references are reused, not fresh same-session timings.','No PyDOE/R/Julia/Colab/GPU or bench_b0 run; no remote sessions. C1 remains closed, not met, 5/8.','', '| Row | value / best efficiency / seconds | floor / stop | value @ restarts=1 | W3 value @ restarts=10 | not comparable (1 vs 10 restarts) | current/W3 seconds (raw / per restart) | vs PyDOE / time | IDs vs W3 (ordered / set) |','|---|---|---|---|---|---|---|---|---|']\nquality=timepass=timed=timeout=0; comparisons=[]\nfor r,o in zip(rows,old):\n    name,c=r['case'],r['criterion']; assert (name,c)==(o['case'],o['criterion'])\n    if r['status']=='TIMEOUT':\n        timeout+=1; lines.append(f'| {name}/{c} | TIMEOUT (3h cap) | N/A | NOT_RUN | N/A | N/A | N/A |'); continue\n    p=len((root/f'reports/w3-heldout/{name}_F.csv').read_text().splitlines()[0].split(','))+1\n    refs=[x for x in data['rows'] if x['case']==name and (x['criterion']==c or x['method'].startswith('PyDOE/'))]\n    values=[x['metrics'][c] for x in refs]+[o['metrics'][c]]; best=max(values) if c=='D' else min(values); v=r['metrics'][c]\n    eff=math.exp((v-best)/p) if c=='D' else best/v\n    qe=math.exp((v-o['metrics'][c])/p) if c=='D' else o['metrics'][c]/v\n    q=qe>=1-1e-9; quality+=q\n    secs=[x['seconds'] for x in refs if x['method'] in ('PyDOE/fedorov','PyDOE/modified_fedorov','PyDOE/detmax')]\n    ratio=r['seconds']/min(secs) if secs else None; timed+=ratio is not None; timepass+=ratio is not None and ratio<=3\n    same=r['ids']==o['ids']; same_set=set(r['ids'])==set(o['ids'])\n    comparisons.append(dict(case=name,criterion=c,value=v,w3_value_restarts_10=o['metrics'][c],efficiency_vs_best=eff,descriptive_value_efficiency_ratio_vs_w3=qe,descriptive_value_ratio_ge_1_minus_1e9=q,quality_comparison='not comparable (1 vs 10 restarts)',seconds_vs_w3_raw=r['seconds']/o['seconds'],seconds_vs_w3_per_restart=10*r['seconds']/o['seconds'],time_ratio_vs_pydoe=ratio,time_pass=None if ratio is None else ratio<=3,ordered_ids_same=same,id_set_same=same_set))\n    lines.append(f\"| {name}/{c} | {v:.10g} / {eff:.10g} / {r['seconds']:.6g} | {r['floor']:.9g} / {r['stop']} | {v:.10g} | {o['metrics'][c]:.10g} | not comparable (1 vs 10 restarts) | {r['seconds']/o['seconds']:.6g}x / {10*r['seconds']/o['seconds']:.6g}x | \"+('N/A' if ratio is None else f\"{ratio:.6g}x / {'PASS' if ratio<=3 else 'FAIL'}\")+f\" | {'same' if same else 'DIFF'} / {'same' if same_set else 'DIFF'} |\")\ndata['comparisons']=comparisons; data['counts']=dict(descriptive_value_ratio_ge_1_minus_1e9=quality,descriptive_value_ratio_below_1_minus_1e9=17-quality-timeout,quality_values_listed=17,quality_comparison='not comparable (1 vs 10 restarts)',time_pass=timepass,time_rows=timed,timeouts=timeout)\ndata['analysis_driver']=Path(__file__).read_text()\nlines+=['',f\"Quality vs W3: not comparable (1 vs 10 restarts); values listed as-is. {timeout} TIMEOUT. Time vs reused PyDOE: {timepass}/{timed} PASS (historical W3 recorded: 3/10, ten restarts/call). All changed designs are marked DIFF above; exact IDs and reused PyDOE/AlgDesign columns are in results.json. No optimization followed these measurements.\"]\n(out/'summary.md').write_text('\\n'.join(lines)+'\\n',encoding='utf-8'); (out/'results.json').write_text(json.dumps(data,allow_nan=False)+'\\n')\nprint(data['counts']); print('Frozen inputs PASS; references unchanged PASS; src/tests/tools unchanged PASS; 17 rows accounted PASS')\n\n\n"}
